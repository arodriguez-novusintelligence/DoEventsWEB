# =============================================================================
# DoEventsWEB - Variables de entorno
# Copiar a .env.local para desarrollo o .env.qa para build QA
# =============================================================================

# Entorno: dev | qa | prod
VITE_DOEVENTS_ENV=qa

# --- OAuth 2.0 ---
# Ver guía completa: infrastructure/oauth/OAUTH_SETUP.md

# Google Cloud → Credenciales → OAuth Client ID (Web)
# Orígenes JS: https://doeventsapp-pre.com , http://localhost:5173
# Redirect URIs:
#   https://doeventsapp-pre.com/auth/callback
#   http://localhost:5173/auth/callback
#   https://doevents-qa.auth.us-east-2.amazoncognito.com/oauth2/idpresponse
VITE_GOOGLE_CLIENT_ID=

# Facebook → App Settings → Valid OAuth Redirect URIs (mismas URLs de arriba)
VITE_FACEBOOK_APP_ID=

# Apple → Services ID (Sign In with Apple)
VITE_APPLE_CLIENT_ID=com.doeventsapp.web.qa

# --- Cognito QA (us-east-2) - completar tras crear User Pool ---
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=doevents-qa.auth.us-east-2.amazoncognito.com

# --- Google Maps (sección Mapa y ubicación del venue) ---
# 1. Ir a https://console.cloud.google.com/apis/credentials
# 2. Crear API Key y habilitar: Maps JavaScript API, Geocoding API, Places API
# 3. Restringir la key por HTTP referrer:
#    https://qa.doeventsapp.com/*
#    https://doeventsapp-pre.com/*
#    http://localhost:5173/*
# 4. Pegar la key aquí y volver a ejecutar: npm run build:qa
VITE_GOOGLE_MAPS_API_KEY=

# --- AWS Deploy (solo para scripts de infraestructura) ---
AWS_REGION=us-east-2
CLOUDFRONT_DISTRIBUTION_ID=
S3_SHELL_BUCKET=doevents-web-qa-shell
S3_AUTH_BUCKET=doevents-web-qa-mfe-auth

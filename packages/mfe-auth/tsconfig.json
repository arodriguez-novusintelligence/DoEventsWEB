{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@doevents/shared": ["../shared/src/index.ts"],
      "@doevents/shared/*": ["../shared/src/*"],
      "@config/*": ["../../config/*"]
    }
  },
  "include": ["src", "../../config"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@doevents/shared": ["../shared/src/index.ts"],
      "@config/*": ["../../config/*"],
      "@mfe-auth/AuthRoutes": ["../mfe-auth/src/AuthRoutes.tsx"],
      "mfeAuth/*": ["../mfe-auth/src/*"],
      "@lovable/*": ["./src/lovable/*"]
    }
  },
  "include": ["src/lovable-bridge", "src/pages", "src/layouts", "src/components", "src/App.tsx", "src/main.tsx", "src/bootstrap.tsx", "src/remotes", "../../config"],
  "exclude": ["src/lovable"]
}
